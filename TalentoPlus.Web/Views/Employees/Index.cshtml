@model IEnumerable<TalentoPlus.Web.Entities.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h2 class="mb-0 text-primary"><i class="bi bi-people-fill me-2"></i>Employees</h2>
            <div>
                <a asp-controller="Upload" asp-action="Index" class="btn btn-outline-success me-2"><i
                        class="bi bi-file-earmark-spreadsheet me-1"></i>Import Excel</a>
                <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Create New</a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.DocumentNumber)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                            <th>@Html.DisplayNameFor(model => model.LastName)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.JobTitle)</th>
                            <th>@Html.DisplayNameFor(model => model.Department)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@Html.DisplayFor(modelItem => item.DocumentNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td><span class="badge bg-info text-dark">@Html.DisplayFor(modelItem =>
                                                                            item.JobTitle)</span></td>
                            <td>@Html.DisplayFor(modelItem => item.Department.Name)</td>
                            <td>
                                @if (item.Status == TalentoPlus.Web.Entities.EmployeeStatus.Active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.Status == TalentoPlus.Web.Entities.EmployeeStatus.Inactive)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">On Leave</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"
                                            title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"
                                            title="Details"><i class="bi bi-info-circle"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                            title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>