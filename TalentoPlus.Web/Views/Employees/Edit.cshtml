@model TalentoPlus.Web.Entities.Employee
@using TalentoPlus.Web.Entities

@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-primary"><i class="bi bi-person-gear me-2"></i>Editar Empleado</h2>
            <p class="text-muted mb-0">Actualiza la información del colaborador</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
        </a>
    </div>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <!-- Columna Izquierda: Información Personal -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Información Personal
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">Nombres</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="FirstName" class="form-control bg-light" readonly />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">Apellidos</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="LastName" class="form-control bg-light" readonly />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DocumentNumber" class="form-label fw-bold">Documento de
                                    Identidad</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-card-heading"></i></span>
                                    <input asp-for="DocumentNumber" class="form-control bg-light" readonly />
                                </div>
                                <span asp-validation-for="DocumentNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BirthDate" class="form-label fw-bold">Fecha de Nacimiento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="BirthDate" class="form-control bg-light" type="date" readonly />
                                </div>
                                <span asp-validation-for="BirthDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">Teléfono</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="+57 300 123 4567" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Address" class="form-label fw-bold">Dirección</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Address" class="form-control" placeholder="Calle 123 # 45-67" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Información Laboral -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 text-primary"><i class="bi bi-briefcase me-2"></i>Información Laboral</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DepartmentId" class="form-label fw-bold">Departamento</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                                    <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="JobTitle" class="form-label fw-bold">Cargo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                                    <input asp-for="JobTitle" class="form-control"
                                        placeholder="Ej: Desarrollador Senior" />
                                </div>
                                <span asp-validation-for="JobTitle" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HireDate" class="form-label fw-bold">Fecha de Contratación</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-check"></i></span>
                                    <input asp-for="HireDate" class="form-control bg-light" type="date" readonly />
                                </div>
                                <span asp-validation-for="HireDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Salary" class="form-label fw-bold">Salario</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-currency-dollar"></i></span>
                                    <input asp-for="Salary" class="form-control" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Salary" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Estado</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-toggle-on"></i></span>
                                    <select asp-for="Status" class="form-select"
                                        asp-items="Html.GetEnumSelectList<EmployeeStatus>()"></select>
                                </div>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EducationLevel" class="form-label fw-bold">Nivel Educativo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-mortarboard"></i></span>
                                    <select asp-for="EducationLevel" class="form-select"
                                        asp-items="Html.GetEnumSelectList<EducationLevel>()"></select>
                                </div>
                                <span asp-validation-for="EducationLevel" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProfessionalProfile" class="form-label fw-bold">Perfil Profesional</label>
                            <textarea asp-for="ProfessionalProfile" class="form-control" rows="4"
                                placeholder="Breve descripción del perfil profesional..."></textarea>
                            <span asp-validation-for="ProfessionalProfile" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-4">
            <button type="submit" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-save me-2"></i>Guardar Cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}