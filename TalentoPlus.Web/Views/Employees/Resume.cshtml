@model TalentoPlus.Web.Entities.Employee

@{
    ViewData["Title"] = "Hoja de Vida";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
        <a asp-action="DownloadResumePdf" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF</a>
    </div>

    <div class="card shadow-lg border-0 mx-auto" style="max-width: 210mm; min-height: 297mm;">
        <div class="card-body p-5">
            <!-- Header -->
            <div class="text-center border-bottom pb-4 mb-4">
                <h1 class="display-5 fw-bold text-uppercase text-primary">@Model.FirstName @Model.LastName</h1>
                <p class="lead mb-1">@Model.JobTitle</p>
                <p class="text-muted mb-0">@Model.Department?.Name</p>
            </div>

            <!-- Contact Info -->
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item me-3"><i class="bi bi-envelope-fill me-1 text-secondary"></i> @Model.Email</li>
                        <li class="list-inline-item me-3"><i class="bi bi-telephone-fill me-1 text-secondary"></i> @Model.PhoneNumber</li>
                        <li class="list-inline-item"><i class="bi bi-geo-alt-fill me-1 text-secondary"></i> @Model.Address</li>
                    </ul>
                </div>
            </div>

            <div class="row">
                <!-- Left Column -->
                <div class="col-md-4 border-end">
                    <div class="mb-4">
                        <h5 class="text-uppercase fw-bold text-primary border-bottom pb-2 mb-3">Datos Personales</h5>
                        <p class="mb-1"><strong>Documento:</strong><br>@Model.DocumentNumber</p>
                        <p class="mb-1"><strong>Fecha Nacimiento:</strong><br>@Model.BirthDate.ToShortDateString()</p>
                        <p class="mb-0"><strong>Estado:</strong><br>
                            @if(Model.Status == TalentoPlus.Web.Entities.EmployeeStatus.Active)
                            {
                                <span class="text-success">Activo</span>
                            }
                            else
                            {
                                <span class="text-muted">@Model.Status</span>
                            }
                        </p>
                    </div>

                    <div class="mb-4">
                        <h5 class="text-uppercase fw-bold text-primary border-bottom pb-2 mb-3">Educación</h5>
                        <p>@Model.EducationLevel</p>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-8 ps-md-4">
                    <div class="mb-4">
                        <h5 class="text-uppercase fw-bold text-primary border-bottom pb-2 mb-3">Perfil Profesional</h5>
                        <p class="text-justify">@Model.ProfessionalProfile</p>
                    </div>

                    <div class="mb-4">
                        <h5 class="text-uppercase fw-bold text-primary border-bottom pb-2 mb-3">Información Laboral</h5>
                        <div class="mb-3">
                            <h6 class="fw-bold">@Model.JobTitle</h6>
                            <p class="text-muted mb-1">@Model.Department?.Name</p>
                            <p class="small text-muted mb-2">
                                <i class="bi bi-calendar-event me-1"></i>Fecha de Ingreso: @Model.HireDate.ToShortDateString()
                            </p>
                            <p class="mb-0"><strong>Salario:</strong> @Model.Salary.ToString("C")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print { display: none !important; }
        body { background-color: white !important; }
        .card { box-shadow: none !important; border: none !important; }
        .container { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
    }
</style>
