@model TalentoPlus.Web.Entities.Employee

@{
    ViewData["Title"] = "Detalles del Empleado";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Detalles del Empleado</h3>
            <div>
                <a asp-action="Resume" asp-route-id="@Model?.Id" class="btn btn-light btn-sm me-2"><i
                        class="bi bi-file-earmark-person me-1"></i>Hoja de Vida</a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-light btn-sm"><i
                        class="bi bi-pencil me-1"></i>Editar</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-primary border-bottom pb-2 mb-3">Información Personal</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Documento</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.DocumentNumber)</dd>

                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.FirstName)</dd>

                        <dt class="col-sm-4">Apellido</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.LastName)</dd>

                        <dt class="col-sm-4">Fecha Nacimiento</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.BirthDate)</dd>

                        <dt class="col-sm-4">Dirección</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h5 class="text-primary border-bottom pb-2 mb-3">Contacto y Cargo</h5>
                    <dl class="row">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Email">@Html.DisplayFor(model => model.Email)</a>
                        </dd>

                        <dt class="col-sm-4">Teléfono</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PhoneNumber)</dd>

                        <dt class="col-sm-4">Cargo</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.JobTitle)</dd>

                        <dt class="col-sm-4">Departamento</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Department.Name)</dd>

                        <dt class="col-sm-4">Fecha Contratación</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.HireDate)</dd>

                        <dt class="col-sm-4">Salario</dt>
                        <dd class="col-sm-8">@Model.Salary.ToString("C", new System.Globalization.CultureInfo("es-CO"))
                        </dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == TalentoPlus.Web.Entities.EmployeeStatus.Active)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else if (Model.Status == TalentoPlus.Web.Entities.EmployeeStatus.Inactive)
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Licencia</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12">
                    <h5 class="text-primary border-bottom pb-2 mb-3">Información Adicional</h5>
                    <dl class="row">
                        <dt class="col-sm-2">Nivel Educativo</dt>
                        <dd class="col-sm-10">@Html.DisplayFor(model => model.EducationLevel)</dd>

                        <dt class="col-sm-2">Perfil Profesional</dt>
                        <dd class="col-sm-10">@Html.DisplayFor(model => model.ProfessionalProfile)</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Volver a la Lista</a>
        </div>
    </div>
</div>