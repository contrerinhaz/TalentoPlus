@model TalentoPlus.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-0 text-primary"><i class="bi bi-speedometer2 me-2"></i>Dashboard - TalentoPlus</h2>
            <p class="text-muted">Bienvenido admin, aquí está el resumen de tu sistema</p>
        </div>
    </div>

    <!-- Estadísticas Principales -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Empleados</h6>
                            <h2 class="mb-0 text-primary">@Model.TotalEmployees</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-people-fill text-primary" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Empleados Activos</h6>
                            <h2 class="mb-0 text-success">@Model.ActiveEmployees</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-person-check-fill text-success" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">En Licencia</h6>
                            <h2 class="mb-0 text-warning">@Model.EmployeesOnLeave</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-calendar-x-fill text-warning" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Segunda fila: Gráficos y Top Salarios -->
    <div class="row g-3 mb-4">
        <!-- Empleados por Departamento -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 text-primary"><i class="bi bi-building me-2"></i>Empleados por Departamento</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Departamento</th>
                                    <th class="text-end">Cantidad</th>
                                    <th style="width: 50%;">Distribución</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.EmployeesByDepartment.OrderByDescending(d => d.Value))
                                {
                                    var percentage = Model.TotalEmployees > 0 ? (dept.Value * 100.0 / Model.TotalEmployees)
                                    : 0;
                                    <tr>
                                        <td>@dept.Key</td>
                                        <td class="text-end"><strong>@dept.Value</strong></td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar bg-primary" role="progressbar"
                                                    style="width: @percentage%" aria-valuenow="@dept.Value"
                                                    aria-valuemin="0" aria-valuemax="@Model.TotalEmployees">
                                                    @percentage.ToString("F0")%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 5 Salarios Más Altos -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 text-primary"><i class="bi bi-trophy-fill me-2"></i>Top 5 Salarios Más Altos</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        @for (int i = 0; i < Model.TopSalaries.Count; i++)
                        {
                            var employee = Model.TopSalaries[i];
                            var badgeClass = i == 0 ? "bg-warning" : i == 1 ? "bg-secondary" : i == 2 ? "bg-info" :
                            "bg-light text-dark";

                            <div class="list-group-item border-0 px-0">
                                <div class="d-flex align-itemscenter justify-content-between">
                                    <div class="d-flex align-items-center flex-grow-1">
                                        <span class="badge @badgeClass me-3" style="width: 30px;">@(i + 1)</span>
                                        <div>
                                            <h6 class="mb-0">@employee.FullName</h6>
                                            <small class="text-muted">@employee.JobTitle - @employee.Department</small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <strong class="text-success">@employee.Salary.ToString("C", new
                                                                                    System.Globalization.CultureInfo("es-CO"))</strong>
                                </div>
                            </div>
                        </div>
                                                }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating AI Assistant Widget -->
<div id="aiChatWidget" class="card shadow-lg border-0 d-none"
    style="position: fixed; bottom: 90px; right: 30px; width: 400px; z-index: 1050; max-height: 80vh; display: flex; flex-direction: column;">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0"><i class="bi bi-robot me-2"></i>Asistente de IA Talento Plus</h5>
            <small style="font-size: 0.8rem;">Consultas en Lenguaje Natural</small>
        </div>
        <button type="button" class="btn-close btn-close-white" onclick="toggleAiChat()" aria-label="Close"></button>
    </div>
    <div class="card-body overflow-auto" style="flex: 1;">
        <div class="mb-3">
            <label class="form-label fw-bold">Haz una pregunta:</label>
            <div class="input-group">
                <input type="text" class="form-control" id="aiQueryInput" placeholder="Ej: ¿Cuántos empleados hay?" />
                <button class="btn btn-primary" type="button" id="askAiBtn">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
            <small class="text-muted d-block mt-2">
                Ejemplos: "¿Cuántos empleados hay en Tecnología?", "¿Cuántos están inactivos?"
            </small>
        </div>

        <div id="aiResponse" class="d-none">
            <div class="alert alert-info" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-robot me-2" style="font-size: 1.5rem;"></i>
                    <div>
                        <strong>Respuesta:</strong>
                        <p class="mb-0 mt-2" id="aiAnswerText"></p>
                    </div>
                </div>
            </div>
        </div>

        <div id="aiLoading" class="d-none text-center py-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Procesando...</span>
            </div>
            <p class="mt-2 text-muted small">Procesando tu consulta...</p>
        </div>

        <div id="aiError" class="d-none">
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span id="aiErrorText"></span>
            </div>
        </div>
    </div>
</div>

<!-- Floating Action Button -->
<button onclick="toggleAiChat()"
    class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center"
    style="position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 1050; transition: transform 0.2s;"
    onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'"
    title="Abrir Asistente IA">
    <i class="bi bi-chat-dots-fill" style="font-size: 1.8rem;"></i>
</button>

@section Scripts {
    <script>
        document.getElementById('askAiBtn').addEventListener('click', askAi);
        document.getElementById('aiQueryInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                askAi();
            }
        });

        function toggleAiChat() {
            var widget = document.getElementById('aiChatWidget');
            if (widget.classList.contains('d-none')) {
                widget.classList.remove('d-none');
                // Focus input when opened
                setTimeout(() => document.getElementById('aiQueryInput').focus(), 100);
            } else {
                widget.classList.add('d-none');
            }
        }

        async function askAi() {
            const query = document.getElementById('aiQueryInput').value.trim();

            if (!query) {
                // Optional: Show a tooltip or small shake animation
                return;
            }

            // Hide previous responses
            document.getElementById('aiResponse').classList.add('d-none');
            document.getElementById('aiError').classList.add('d-none');
            document.getElementById('aiLoading').classList.remove('d-none');

            try {
                const response = await fetch('/Dashboard/AskAi', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ query: query })
                });

                const data = await response.json();

                document.getElementById('aiLoading').classList.add('d-none');

                if (data.success) {
                    document.getElementById('aiAnswerText').textContent = data.answer;
                    document.getElementById('aiResponse').classList.remove('d-none');
                } else {
                    document.getElementById('aiErrorText').textContent = data.errorMessage || 'Error desconocido';
                    document.getElementById('aiError').classList.remove('d-none');
                }
            } catch (error) {
                document.getElementById('aiLoading').classList.add('d-none');
                document.getElementById('aiErrorText').textContent = 'Error de conexión: ' + error.message;
                document.getElementById('aiError').classList.remove('d-none');
            }
        }
    </script>
}